{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robusta.dev/schemas/behavioral-scenarios-v2.json",
  "title": "Robusta product behavior scenario catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "catalogId",
    "updated",
    "sourceDecisionIds",
    "decisionGates",
    "scenarios"
  ],
  "properties": {
    "$schema": { "const": "https://robusta.dev/schemas/behavioral-scenarios-v2.json" },
    "schemaVersion": { "const": 2 },
    "catalogId": { "const": "product-behavior" },
    "updated": { "type": "string", "format": "date" },
    "sourceDecisionIds": { "$ref": "#/$defs/decisionIds" },
    "decisionGates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decisionGate" }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "decisionIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9]{4}$" }
    },
    "decisionGate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "decisionLevel", "decisionStatus", "sourceRef"],
      "properties": {
        "id": { "type": "string", "pattern": "^(product|technical)\\.[a-z0-9-]+$" },
        "decisionLevel": { "enum": ["product", "technical"] },
        "decisionStatus": { "enum": ["backlog", "draft", "proposed", "accepted", "rejected", "superseded"] },
        "sourceRef": { "type": "string", "minLength": 1 }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "sourceDecisionIds",
        "specificationStatus",
        "sourceProofRefs",
        "actors",
        "given",
        "when",
        "then",
        "qualityFacets",
        "conformanceTestIds",
        "decisionDependencies"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "title": { "type": "string", "minLength": 1 },
        "sourceDecisionIds": { "$ref": "#/$defs/decisionIds" },
        "specificationStatus": { "const": "specified" },
        "sourceProofRefs": { "$ref": "#/$defs/nonEmptyStrings" },
        "actors": { "$ref": "#/$defs/nonEmptyStrings" },
        "given": { "$ref": "#/$defs/nonEmptyStrings" },
        "when": { "$ref": "#/$defs/nonEmptyStrings" },
        "then": { "$ref": "#/$defs/nonEmptyStrings" },
        "qualityFacets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "sdk",
              "external-use",
              "diagnostics",
              "tests",
              "documentation",
              "inspection",
              "packaging",
              "compatibility",
              "performance",
              "trust"
            ]
          }
        },
        "conformanceTestIds": { "$ref": "#/$defs/nonEmptyStrings" },
        "decisionDependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^(product|technical)\\.[a-z0-9-]+$" }
        }
      }
    }
  }
}
